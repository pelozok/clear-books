rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // La pareja entra con su propio Google: su correo debe coincidir con
    // partnerEmail del perfil del hogar (users/{uid}/config/profile).
    // Solo correos verificados por el proveedor (Google): nadie puede "tomar" un correo
    // de la lista registrándose con otro método sin verificarlo.
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isPartner(uid) {
      return verified()
        && request.auth.token.email != null
        && get(/databases/$(database)/documents/users/$(uid)/config/profile).data.partnerEmail == request.auth.token.email;
    }

    // Allowlist de correos que pueden crear su propio hogar.
    // PARA DAR ACCESO A ALGUIEN NUEVO: agregar su correo a esta lista y desplegar
    // (ver docs/FIREBASE.md). La pareja invitada no necesita estar aquí para entrar
    // al hogar del dueño, pero sí para tener un perfil propio con partnerOf.
    function isAllowed() {
      return verified()
        && request.auth.token.email in [
             'kevindp2008@gmail.com',
             'astridfatjo@gmail.com',
             'viviretamar00@gmail.com',
             'dpelozof@gmail.com',
             'cammpelozo@gmail.com',
             'katheryn.b.pelozo@gmail.com'
           ];
    }

    // La pareja anota en todo el hogar menos config/ (el perfil): ahí solo puede
    // actualizar, sin tocar quién comparte el hogar ni borrarlo (regla de abajo).
    match /users/{uid}/{col}/{rest=**} {
      allow read: if (isOwner(uid) && isAllowed()) || isPartner(uid);
      allow write: if (isOwner(uid) && isAllowed()) || (isPartner(uid) && col != 'config');
    }

    match /users/{uid}/config/profile {
      allow update: if isPartner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['partnerEmail', 'partnerOf']);
    }
  }
}
